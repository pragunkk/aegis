# AegisPay Gateway Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# AP2 Cryptographic Mandate Verification Secret
AP2_SECRET_KEY=aegis_ap2_super_secret_mandate_signing_key_2026

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# OpenAI Configuration (Optional for embeddings / semantic fallback)
OPENAI_API_KEY=sk-your-openai-api-key
