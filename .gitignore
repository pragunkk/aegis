# ==============================================================================
# AegisPay Gateway: Root .gitignore
# ==============================================================================

# --- Environment & Secret Configuration ---
.env
.env.*
*.env
frontend/.env
frontend/.env.*
!*.env.example
!**/*.env.example

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.npm
*.tsbuildinfo

# --- Logs & Runtime Output ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Databases & SQLite ---
*.sqlite
*.sqlite3
*.db

# --- Operating System & Temporary Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo

# --- IDEs & Editors ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
.agent/
.agents/
.gemini/
